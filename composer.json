{
    "name": "erikgall/samsara",
    "description": "Laravel SDK for the Samsara Fleet Management API",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Samsara\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Samsara\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Erik Galloway",
            "email": "8866568+erikgall@users.noreply.github.com"
        }
    ],
    "archive": {
        "exclude": [
            "/.ai",
            "/.claude",
            "/.DS_Store",
            "/.env*",
            "/.github",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/.prettierrc",
            "/auth.json",
            "/CLAUDE.md",
            "/DEVELOPMENT_CHANGELOG.md",
            "/composer.lock",
            "/contracts",
            "/docs",
            "/node_modules",
            "/notes",
            "/package-lock.json",
            "/package.json",
            "/phpstan.neon",
            "/phpunit.xml",
            "/pint.json",
            "/samsara.json",
            "/scripts",
            "/tests",
            "/vendor"
        ]
    },
    "require": {
        "php": "^8.2",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/collections": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "1.30.4",
        "phpunit/phpunit": "^11.0|^12.0",
        "phpstan/phpstan": "^2.2",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Samsara\\SamsaraServiceProvider"
            ],
            "aliases": {
                "Samsara": "Samsara\\Facades\\Samsara"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit tests/Unit tests/Feature tests/Maintenance",
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=512M",
        "format": "vendor/bin/pint",
        "format:test": "vendor/bin/pint --test",
        "check:maintenance": [
            "@php scripts/validate-samsara-snapshot.php",
            "@php scripts/check-samsara-contract-reconciliation.php",
            "@check:v2-upgrade-guide"
        ],
        "check": [
            "@test",
            "@analyse",
            "@format:test",
            "@check:maintenance"
        ],
        "check:v2-upgrade-guide": "php scripts/check-v2-upgrade-guide.php"
    },
    "config": {
        "sort-packages": true
    }
}
