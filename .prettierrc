{
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "singleQuote": true,
    "overrides": [
        {
            "files": "*.{yml,yaml}",
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": "package-lock.json",
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
